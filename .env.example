# Copy these values into Netlify Site configuration > Environment variables.
# Never commit real keys to GitHub.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Keep privileged service-role credentials server-side only if a later function requires them.
# SUPABASE_SERVICE_ROLE_KEY=NEVER_PUT_THIS_IN_FRONTEND_OR_GITHUB
